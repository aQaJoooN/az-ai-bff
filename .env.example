# Required configuration for az-ai-bff
# Copy this file to .env and update the values

# Server configuration
AZ_AI_BFF_INTERNAL_HOST=0.0.0.0
AZ_AI_BFF_INTERNAL_PORT=8000
AZ_AI_BFF_TRUSTED_PROXY_ADDRESSES=["nginx"]  # Trust nginx proxy in Docker
#AZ_AI_BFF_TRUSTED_PROXY_ADDRESSES='["0.0.0.0"]' # IPs allowed to set proxy headers

# Authentication (optional - leave empty to disable)
AZ_AI_BFF_ACCESS_CREDENTIAL=

# Azure DevOps on-premise token (required for /api/v1/analyze)
AZ_AI_BFF_AZURE_TOKEN=your-azure-devops-pat  # PAT or service account token for on-prem TFS/Azure DevOps

# AI Backend configuration
AZ_AI_BFF_BACKEND_URL=http://your-ai-backend-url/v1/chat
AZ_AI_BFF_BACKEND_MODEL=your-model-name
AZ_AI_BFF_BACKEND_CREDENTIAL=  # Optional: leave empty if backend doesn't require auth
AZ_AI_BFF_BACKEND_FORMAT=openai  # Options: "simple" or "openai"
AZ_AI_BFF_BACKEND_ID=primary
AZ_AI_BFF_BACKEND_REASONING_MODE=false  # set true for reasoning models (DeepSeek, Qwen3, etc.) that respond in reasoning_content

# Multi-AI configuration (optional)
AZ_AI_BFF_MULTI_AI_ENABLED=false

# Timeouts
AZ_AI_BFF_RESPONSE_TIMEOUT_SECONDS=30
AZ_AI_BFF_CONNECT_TIMEOUT_SECONDS=5

# Concurrency — maximum simultaneous AI backend requests across all endpoints.
# The 6th concurrent request receives 429 "rate_limit_exceeded".
# Set to 0 to disable the limit entirely.
AZ_AI_BFF_MAX_CONCURRENT_AI_REQUESTS=5

# Token management (optional)
AZ_AI_BFF_TOKEN_BUDGET_ENABLED=false
AZ_AI_BFF_INPUT_TOKEN_BUDGET=4096
AZ_AI_BFF_OUTPUT_TOKEN_LIMIT=1024
AZ_AI_BFF_TOKEN_CHARACTERS_PER_TOKEN=4.0

# Global max_tokens cap (optional) — if set, appended as max_tokens to every AI request
# Takes effect only when AZ_AI_BFF_TOKEN_BUDGET_ENABLED=false or as a fallback
# AZ_AI_BFF_MAX_TOKENS=500

# CORS (required for Azure DevOps extension)
# Add your specific Azure DevOps organization URL
AZ_AI_BFF_ALLOWED_EXTENSION_ORIGINS='["https://dev.azure.com", "https://*.visualstudio.com"]'

# Note: For Azure DevOps extension to work, you must:
# 1. Install the AI Analyzer extension from: https://github.com/aQaJoooN/azure-devops-build-ai-reviewer
# 2. Add your specific Azure DevOps organization URL to the allowed origins
# 3. If using HTTPS on Azure DevOps, ensure this BFF is also published with HTTPS